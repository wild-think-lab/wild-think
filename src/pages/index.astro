---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { u, tagHref } from '../lib/url';
import { SITE, TOPICS, CATEGORIES, topicById } from '../lib/site';
import { allPosts, allTags, postHref, postTopicId, fmtDate } from '../lib/posts';
import { getCollection } from 'astro:content';
import { COURSES } from '../data/courses';

const posts = await allPosts();
const latest = posts.slice(0, 6);
const tags = (await allTags()).slice(0, 14);

const learnEntries = await getCollection('learn');
const courseCount = (id: string) =>
  learnEntries.filter((e) => e.id.startsWith(id + '/')).length;

const topicCount = (id: string) => posts.filter((p) => postTopicId(p) === id).length;

const map = CATEGORIES.map((c) => ({
  ...c,
  topics: TOPICS.filter((t) => t.category === c.id),
}));

const featured = posts.filter((p) => p.data.featured).slice(0, 3);
const picks = featured.length >= 3 ? featured : posts.slice(0, 3);
---

<BaseLayout title="" description={SITE.desc} active="home">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <div class="kicker">野生思考 · wild think</div>
        <h1>把复杂的技术<br />写成<em>可以走的路</em></h1>
        <p class="hero-tagline">{SITE.tagline}</p>
        <p class="hero-desc">
          这里不搬运视频教程，也不堆砌命令清单。每一篇都讲清一件事：为什么这样设计、
          在什么场景生效、怎么验证它真的生效了。
        </p>

        <div class="hero-cta">
          <a class="btn btn-primary" href={u('/learn')}>
            从零开始学
            <Icon name="arrowRight" size={16} />
          </a>
          <a class="btn" href={u('/topics')}>知识地图</a>
          <a class="btn" href={u('/writing')}>全部文章</a>
        </div>

        <div class="hero-stats">
          <div class="stat"><b>{String(posts.length).padStart(2, '0')}</b><span>篇笔记</span></div>
          <div class="stat"><b>{String(TOPICS.length).padStart(2, '0')}</b><span>个专题</span></div>
          <div class="stat"><b>{String(tags.length).padStart(2, '0')}</b><span>个标签</span></div>
          <div class="stat"><b>100%</b><span>可复现</span></div>
        </div>

        <div class="hero-strip">
          <span class="live-dot"></span>
          持续更新中
          <span style="opacity:.4">/</span>
          最后更新 {posts.length ? fmtDate(posts[0].data.date) : '—'}
        </div>
      </div>

      <div class="term">
        <div class="term-bar">
          <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
          <span class="term-title">wild-think — notes</span>
        </div>
        <div class="term-body">
          <div><span class="p">➜</span> <span class="cmd">cat README.md</span></div>
          <div class="cmt"># 一个写给底层技术实践者的知识库</div>
          <div><span class="p">➜</span> <span class="cmd">ls topics/</span></div>
          <div class="cmt">linux windows network shell monitor</div>
          <div class="cmt">sre-cloud virtual devops db security</div>
          <div class="cmt">fullstack lab project tools interview</div>
          <div><span class="p">➜</span> <span class="cmd">make reproduce</span></div>
          <div class="ok">✔ 环境就绪 · 步骤可验证 · 结果可回滚</div>
          <div><span class="p">➜</span> <span class="cmd">echo $PHILOSOPHY</span></div>
          <div>“把复杂的技术，变成可以落地复现的思考与实践”<span class="caret"></span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 01 从这里开始 -->
  <section class="section home-start">
    <div class="container">
      <div class="sec-head">
        <span class="sec-no">01</span>
        <h2>从这里开始，按顺序学</h2>
        <span class="sec-en">START FROM ZERO</span>
        <a class="more" href={u('/learn')}>全部课程 <Icon name="arrowRight" size={14} /></a>
      </div>

      <div class="course-row">
        {
          COURSES.map((c) => (
            <a class="course-card2" href={u(`/learn/${c.id}`)} style={`--acc:${c.accent}`}>
              <div class="cc2-top">
                <span class="cc2-icon"><Icon name={c.icon} size={18} /></span>
                <span class="cc2-tag">{c.tag}</span>
              </div>
              <h3>{c.name}</h3>
              <p>{c.desc}</p>
              <div class="cc2-foot">
                <span class="cc2-ch">{courseCount(c.id)} 章 · 按顺序</span>
                <span class="cc2-go">开始 <Icon name="arrowRight" size={13} /></span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 02 知识地图 -->
  <section class="section home-map">
    <div class="container">
      <div class="sec-head">
        <span class="sec-no">02</span>
        <h2>知识地图</h2>
        <span class="sec-en">{TOPICS.length} TOPICS / {CATEGORIES.length} GROUPS</span>
        <a class="more" href={u('/topics')}>完整地图 <Icon name="arrowRight" size={14} /></a>
      </div>

      <div class="map-mini">
        {
          map.map((g) => (
            <div class="mm-group">
              <div class="mm-title">
                <b>{g.name}</b>
                <span>{g.topics.length}</span>
              </div>
              {g.topics.map((t) => (
                <a class="mm-link" href={u(`/topics/${t.id}`)} style={`--acc:${t.accent}`}>
                  <span class="mm-icon"><Icon name={t.icon} size={13} /></span>
                  <span class="mm-name">{t.name}</span>
                  <span class="mm-count">{topicCount(t.id)}</span>
                </a>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 03 精选 -->
  <section class="section home-featured">
    <div class="container">
      <div class="sec-head">
        <span class="sec-no">03</span>
        <h2>先读这几篇</h2>
        <span class="sec-en">PICKS</span>
      </div>

      <div class="pick-grid">
        {
          picks.map((p, i) => {
            const t = topicById(postTopicId(p));
            return (
              <a class="pick-card" href={u(postHref(p))} style={`--acc:${t?.accent ?? '#ff8a3d'}`}>
                <span class="pk-no">{String(i + 1).padStart(2, '0')}</span>
                <span class="pk-topic">{t?.name ?? '笔记'}</span>
                <h3>{p.data.title}</h3>
                <p>{p.data.description}</p>
                <span class="pk-date">{fmtDate(p.data.date)}</span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- 04 最近更新 -->
  <section class="section home-latest">
    <div class="container">
      <div class="sec-head">
        <span class="sec-no">04</span>
        <h2>最近更新</h2>
        <span class="sec-en">LATEST</span>
        <a class="more" href={u('/writing')}>全部文章 <Icon name="arrowRight" size={14} /></a>
      </div>

      <div class="note-list">
        {
          latest.map((post, i) => {
            const t = topicById(postTopicId(post));
            return (
              <a class="note-item" href={u(postHref(post))}>
                <span class="ni-no">{String(i + 1).padStart(2, '0')}</span>
                <span class="ni-main">
                  <strong>{post.data.title}</strong>
                  <em>{post.data.description}</em>
                </span>
                <span class="ni-meta">
                  <em>{t?.en ?? 'NOTES'}</em>
                  <time>{fmtDate(post.data.date)}</time>
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- 05 工具与路线 -->
  <section class="section home-duo">
    <div class="container">
      <div class="duo-grid">
        <a class="duo-card" href={u('/toolbox')}>
          <div class="dc-top">
            <span class="dc-icon"><Icon name="tool" size={18} /></span>
            <span class="dc-kicker">TOOLBOX · 789 SITES</span>
          </div>
          <h3>工具箱</h3>
          <p>26 个分类、789 个工具站点，按用途搜索，按场景直达。找不到合适的工具时，先来这里翻一遍。</p>
          <span class="dc-go">打开工具箱 <Icon name="arrowRight" size={14} /></span>
        </a>
        <a class="duo-card" href={u('/roadmap')}>
          <div class="dc-top">
            <span class="dc-icon"><Icon name="layers" size={18} /></span>
            <span class="dc-kicker">ROADMAP · 4 TRACKS</span>
          </div>
          <h3>能力路线</h3>
          <p>运维、SRE、网络、安全四条主线，每条分 L1–L4 四级，每一级都有可验证的产出标准。</p>
          <span class="dc-go">查看路线 <Icon name="arrowRight" size={14} /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- 06 标签 -->
  <section class="section home-tags">
    <div class="container">
      <div class="sec-head">
        <span class="sec-no">05</span>
        <h2>标签</h2>
        <span class="sec-en">TAGS</span>
        <a class="more" href={u('/tags')}>全部标签 <Icon name="arrowRight" size={14} /></a>
      </div>
      <div class="chips">
        {tags.map((t) => <a class="chip" href={tagHref(t.tag)}>#{t.tag}</a>)}
      </div>
    </div>
  </section>
</BaseLayout>
