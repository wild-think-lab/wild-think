---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import CourseTree from '../../components/CourseTree.astro';
import { u } from '../../lib/url';
import { getCollection } from 'astro:content';
import { COURSES } from '../../data/courses';

export async function getStaticPaths() {
  return COURSES.map((c) => ({ params: { course: c.id }, props: { course: c } }));
}

const { course } = Astro.props;

const entries = (await getCollection('learn'))
  .filter((e) => e.id.startsWith(course.id + '/'))
  .sort((a, b) => a.id.localeCompare(b.id));

const noOf = (id: string) => id.split('/').pop()?.slice(0, 2) ?? '';
const slugOf = (id: string) => (id.split('/').pop() ?? '').replace(/\.mdx?$/i, '');

const items = entries.map((entry) => ({
  key: noOf(entry.id),
  no: noOf(entry.id),
  title: entry.data.title,
  summary: entry.data.summary,
  minutes: entry.data.minutes,
  module: entry.data.module,
  slug: slugOf(entry.id),
  href: u(`/learn/${course.id}/${slugOf(entry.id)}`),
}));

const modules: { name: string; items: typeof items }[] = [];
for (const it of items) {
  let g = modules.find((x) => x.name === it.module);
  if (!g) {
    g = { name: it.module, items: [] };
    modules.push(g);
  }
  g.items.push(it);
}

const total = items.length;
const first = items[0];
---

<BaseLayout title={course.name} description={`${course.name}：${course.desc}`} active="learn">
  <div class="course-wrap container">
    <CourseTree course={course} modules={modules} total={total} />

    <main class="course-main">
      <div class="page-head" style="border-bottom:0;padding-bottom:10px">
        <div class="kicker" style={`color:${course.accent}`}>{course.en}</div>
        <h1>{course.name}</h1>
        <p>{course.desc}</p>
        <div class="cm-meta">
          <span>{modules.length} 个模块</span>
          <span>{total} 章</span>
          <span>{course.tag}</span>
        </div>
      </div>

      <div class="cm-can">
        <span class="cm-can-title">学完你能</span>
        <ul>
          {course.can.map((x) => <li>{x}</li>)}
        </ul>
      </div>

      {
        first && (
          <a class="cm-start" href={first.href}>
            从第 {first.no} 章开始 · {first.title}
            <Icon name="arrowRight" size={14} />
          </a>
        )
      }

      <div class="cm-list-note">
        一章一页，读完一章再进下一章。左边目录可以随时跳到任意一章。
      </div>

      {
        modules.map((m, mi) => (
          <section class="cm-module">
            <div class="cm-module-head">
              <span class="cm-module-index">{String(mi + 1).padStart(2, '0')}</span>
              <h2>{m.name}</h2>
              <span class="cm-module-count">{m.items.length} 章</span>
            </div>

            <div class="cm-chapters">
              {m.items.map((it) => (
                <a class="cm-ch" href={it.href}>
                  <span class="cm-ch-no">{it.no}</span>
                  <span class="cm-ch-body">
                    <span class="cm-ch-title">{it.title}</span>
                    {it.summary && <span class="cm-ch-sum">{it.summary}</span>}
                  </span>
                  {it.minutes && <span class="cm-ch-min">{it.minutes} 分钟</span>}
                  <Icon name="arrowRight" size={13} />
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </main>
  </div>
</BaseLayout>

<style>
  .course-wrap {
    display: grid;
    grid-template-columns: 216px minmax(0, 1fr);
    gap: 40px;
    align-items: start;
    padding-top: 34px;
    padding-bottom: 90px;
  }

  .course-main {
    min-width: 0;
  }

  .cm-meta {
    display: flex;
    gap: 16px;
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--dim);
    letter-spacing: 0.04em;
  }

  .cm-can {
    margin: 18px 0 24px;
    padding: 16px 20px;
    border: 1px solid var(--line);
    border-left: 2px solid var(--accent);
    border-radius: 0 10px 10px 0;
    background: var(--panel);
  }

  .cm-can-title {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  .cm-can ul {
    margin: 8px 0 0;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cm-can li {
    font-size: 12.5px;
    color: var(--muted);
    line-height: 1.7;
  }

  .cm-start {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border-radius: 8px;
    border: 1px solid var(--accent-line);
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 12.5px;
  }

  .cm-start:hover {
    background: color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .cm-list-note {
    margin: 14px 0 34px;
    font-size: 11.5px;
    color: var(--dim);
  }

  .cm-module {
    margin-bottom: 34px;
  }

  .cm-module-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 10px;
    margin-bottom: 6px;
    border-bottom: 1px solid var(--line-strong);
  }

  .cm-module-index {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
  }

  .cm-module-head h2 {
    margin: 0;
    font-size: 17px;
    letter-spacing: -0.01em;
  }

  .cm-module-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--dim);
  }

  .cm-chapters {
    display: flex;
    flex-direction: column;
  }

  .cm-ch {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 13px 10px;
    border-bottom: 1px dashed var(--line);
    border-radius: 6px;
    color: var(--text);
    transition: background 0.15s;
  }

  .cm-ch:hover {
    background: var(--panel);
  }

  .cm-ch-no {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    color: var(--accent);
    border: 1px solid var(--accent-line);
    border-radius: 5px;
    padding: 1px 6px;
    margin-top: 2px;
  }

  .cm-ch-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cm-ch-title {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.5;
  }

  .cm-ch-sum {
    font-size: 12px;
    color: var(--dim);
    line-height: 1.6;
  }

  .cm-ch-min {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--dim);
    margin-top: 3px;
  }

  .cm-ch :global(svg) {
    flex: 0 0 auto;
    margin-top: 4px;
    color: var(--dim);
  }

  .cm-ch:hover :global(svg) {
    color: var(--accent);
  }

  @media (max-width: 980px) {
    .course-wrap {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }
  }
</style>
