---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { u, tagHref } from '../../lib/url';
import { topicById } from '../../lib/site';
import {
  allPosts,
  postHref,
  postSlug,
  postTopicId,
  fmtDate,
} from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const topic = topicById(postTopicId(post));

const all = await allPosts();
const idx = all.findIndex((p) => p.id === post.id);
const newer = idx > 0 ? all[idx - 1] : null;
const older = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null;

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const updated = post.data.updated;
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  active="writing"
  ogType="article"
>
  <div class="reading-bar" id="reading-bar"></div>

  <div class="container">
    <div class="breadcrumb" style="padding-top:26px">
      <a href={u('/')}>首页</a><i>/</i>
      <a href={u(`/topics/${topic?.id ?? ''}`)}>{topic?.name ?? '未分类'}</a><i>/</i>
      <span>{post.data.title}</span>
    </div>

    <div class="article-wrap">
      <article>
        <header class="article-head">
          <h1>{post.data.title}</h1>
          <div class="article-meta">
            {topic && (
              <a class="topic-pill" href={u(`/topics/${topic.id}`)}>{topic.en}</a>
            )}
            <span>{fmtDate(post.data.date)}</span>
            {updated && (
              <>
                <span class="sep">·</span>
                <span>更新 {fmtDate(updated)}</span>
              </>
            )}
          </div>
          {post.data.description && <p class="article-lead">{post.data.description}</p>}
        </header>

        <div class="prose" style="margin-top:34px">
          <Content />
        </div>

        <footer class="article-foot">
          {post.data.tags.length > 0 && (
            <div class="article-tags">
              {post.data.tags.map((t) => (
                <a class="chip" href={tagHref(t)}>#{t}</a>
              ))}
            </div>
          )}

          <div class="prevnext">
            {older ? (
              <a class="pn" href={u(postHref(older))}>
                <small>← 上一篇</small>
                <span>{older.data.title}</span>
              </a>
            ) : (
              <div />
            )}
            {newer ? (
              <a class="pn next" href={u(postHref(newer))}>
                <small>下一篇 →</small>
                <span>{newer.data.title}</span>
              </a>
            ) : (
              <div />
            )}
          </div>

          <div style="margin-top:26px;font-family:var(--font-mono);font-size:11.5px;color:var(--dim);letter-spacing:.04em">
            // 如需转载，注明来源即可 · {topic?.name ?? 'wild-think'}
          </div>
        </footer>
      </article>

      {
        toc.length > 2 && (
          <aside class="toc" id="toc">
            <div class="toc-title">On this page</div>
            <ul>
              {toc.map((h) => (
                <li class={h.depth === 3 ? 'depth-3' : 'depth-2'}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </div>

  <script>
    // 阅读进度
    const bar = document.getElementById('reading-bar');
    const update = () => {
      const h = document.documentElement;
      const total = h.scrollHeight - h.clientHeight;
      const p = total > 0 ? (h.scrollTop / total) * 100 : 0;
      if (bar) bar.style.width = Math.min(100, Math.max(0, p)) + '%';
    };
    document.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();

    // 目录高亮
    const links = Array.from(document.querySelectorAll('#toc a')) as HTMLAnchorElement[];
    const targets = links
      .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter(Boolean) as HTMLElement[];
    if (targets.length) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            links.forEach((a) =>
              a.classList.toggle(
                'active',
                decodeURIComponent(a.hash.slice(1)) === e.target.id
              )
            );
          });
        },
        { rootMargin: '-90px 0px -70% 0px', threshold: 0 }
      );
      targets.forEach((t) => io.observe(t));
    }
  </script>
</BaseLayout>
