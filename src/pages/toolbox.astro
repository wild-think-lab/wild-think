---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import toolbox from '../data/toolbox.json';

type Item = { name: string; url: string; desc: string };
type Group = { group: string; items: Item[] };

const raw = toolbox as Group[];

// 展示顺序：技术类靠前，生活娱乐靠后
const ORDER = [
  '🛠️ 效率工具',
  '🐧 奇妙的 Linux 世界',
  '🧑‍💻 编程开发',
  '🧰 网络调试',
  '🐳 云原生容器化',
  '🪞 镜像加速',
  '🔐 安全相关',
  '🌠 探索 GitHub',
  '🤖 AI 新世界',
  '👨‍💻 AI 编程',
  '📕 AI 翻译利器',
  '🖼 AI 绘图',
  '☁ 云服务',
  '🎁 玩转 NixOS',
  '🍎 苹果实验室',
  '🔎 搜索引擎',
  '📔 博客网摘',
  '🏢 职来职往',
  '📰 新闻资讯',
  '📧 电子邮件',
  '🖼 绘图设计',
  '🚖 出行服务',
  '🤹‍♂️ 趣站酷软',
  '📷 光影时刻',
  '🎸 音乐之声',
  '🕹 头号玩家',
];

const rank = (name: string) => {
  const i = ORDER.indexOf(name);
  return i === -1 ? 999 : i;
};
const groups = [...raw].sort((a, b) => rank(a.group) - rank(b.group));

const totalItems = groups.reduce((n, g) => n + g.items.length, 0);
const gid = (i: number) => `g-${i}`;

// 分类名去掉 emoji，用于侧栏与搜索关键词
const plain = (s: string) => s.replace(/[\p{Emoji_Presentation}\p{Extended_Pictographic}\uFE0F\u200D]/gu, '').trim();

const dataUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/data/toolbox.json`;

const withDesc = groups.reduce((n, g) => n + g.items.filter((i) => i.desc).length, 0);
const hosts = new Set(
  groups.flatMap((g) =>
    g.items
      .map((i) => {
        try {
          return new URL(i.url).hostname;
        } catch {
          return '';
        }
      })
      .filter(Boolean)
  )
);
---

<BaseLayout
  title="工具箱"
  description="野生思考工具箱：26 个分类、789 个技术站点与在线工具，覆盖效率、Linux、网络调试、云原生、安全、AI、开发与生活场景，全部可跳转。"
  active="toolbox"
>
  <section class="section tool-page">
    <div class="container">
      <div class="page-head">
        <div class="kicker">TOOLBOX · 工具导航</div>
        <h1>把好用的工具，<br />收进一座随身的小仓库</h1>
        <p>
          日常排障、写代码、查资料、做图会反复打开的那些站点，按场景收在这里。
          每条都能直接跳转，带一句话说明它到底解决什么问题——不用再靠记忆去翻收藏夹。
        </p>
      </div>

      <div class="tool-stats">
        <div class="stat"><b>{groups.length}</b><span>个分类</span></div>
        <div class="stat"><b>{totalItems}</b><span>个工具 / 站点</span></div>
        <div class="stat"><b>{hosts.size}</b><span>个独立域名</span></div>
        <div class="stat"><b>{withDesc}</b><span>条带用途说明</span></div>
      </div>

      <div class="tool-search">
        <Icon name="search" size={18} />
        <input
          id="tool-q"
          type="search"
          placeholder="搜工具名、用途或分类，例如 nginx、截图、镜像加速"
          autocomplete="off"
          aria-label="搜索工具"
        />
        <span class="tool-count" id="tool-count">{totalItems} 条</span>
        <kbd>/</kbd>
      </div>

      <div class="tool-layout">
        <aside class="tool-side">
          <div class="tool-side-inner">
            <div class="tool-side-title">分类目录</div>
            {
              groups.map((g, i) => (
                <a class="tool-side-link" href={`#${gid(i)}`} data-target={gid(i)}>
                  <span>{plain(g.group)}</span>
                  <em>{g.items.length}</em>
                </a>
              ))
            }
            <a class="tool-side-link tool-side-top" href="#top">
              <span>回到顶部</span>
            </a>
          </div>
        </aside>

        <div class="tool-body" id="tool-body" data-src={dataUrl}>
          {
            groups.map((g, i) => (
              <section class="tool-group" id={gid(i)} data-group={plain(g.group)} data-gi={i}>
                <h2 class="tool-group-title">
                  {g.group}
                  <em data-n={g.items.length}>{g.items.length}</em>
                </h2>
                <div class="tool-grid" />
              </section>
            ))
          }
          <div class="tool-empty" id="tool-empty" hidden>
            没有匹配的工具，换个关键词试试。
          </div>
        </div>
      </div>

      <p class="tool-note">
        收录原则：只留还在维护、打开就能用的站点；分类按使用场景而非公司品牌划分。
        敏感数据不要往第三方在线工具里贴——尤其是内网地址、密钥、生产日志。
        <br />
        初始清单参考了公开的技术导航站点（Zinx 工具箱，xiaopangq.github.io），本站重新分类、去重并逐条核对可用性，文字说明为本站重写。
      </p>
    </div>
  </section>

  <script>
    const q = document.getElementById('tool-q') as HTMLInputElement | null;
    const countEl = document.getElementById('tool-count');
    const emptyEl = document.getElementById('tool-empty');
    const body = document.getElementById('tool-body');
    const shells = Array.from(document.querySelectorAll('.tool-group')) as HTMLElement[];
    const total = shells.reduce((n, s) => n + Number(s.querySelector('.tool-group-title em')?.getAttribute('data-n') || 0), 0);

    type Item = { name: string; url: string; desc: string };
    type Group = { group: string; items: Item[] };
    const plain = (s: string) => s.replace(/[\p{Emoji_Presentation}\p{Extended_Pictographic}\uFE0F\u200D]/gu, '').trim();

    const rendered = new Set<HTMLElement>();
    let index = new Map<string, Item[]>();

    const itemNode = (it: Item, groupName: string) => {
      const a = document.createElement('a');
      a.className = 'titem';
      a.href = it.url;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.dataset.k = `${it.name} ${it.desc} ${groupName}`.toLowerCase();
      const name = document.createElement('span');
      name.className = 'titem-name';
      name.textContent = it.name;
      name.innerHTML += ' <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17L17 7M17 7H9M17 7v8"/></svg>';
      a.appendChild(name);
      if (it.desc) {
        const d = document.createElement('span');
        d.className = 'titem-desc';
        d.textContent = it.desc;
        a.appendChild(d);
      }
      return a;
    };

    const renderGroup = (shell: HTMLElement) => {
      if (rendered.has(shell)) return;
      rendered.add(shell);
      const name = shell.dataset.group || '';
      const items = index.get(name) || [];
      const grid = shell.querySelector('.tool-grid');
      if (!grid) return;
      const frag = document.createDocumentFragment();
      for (const it of items) frag.appendChild(itemNode(it, name));
      grid.appendChild(frag);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (en.isIntersecting) {
            renderGroup(en.target as HTMLElement);
            io.unobserve(en.target);
          }
        }
      },
      { rootMargin: '600px 0px' }
    );

    const renderAll = () => {
      for (const s of shells) renderGroup(s);
      for (const s of shells) io.unobserve(s);
    };

    const apply = (kw: string) => {
      const k = kw.trim().toLowerCase();
      if (k) renderAll();
      let shown = 0;
      for (const s of shells) {
        const items = Array.from(s.querySelectorAll('.titem')) as HTMLElement[];
        let local = 0;
        for (const it of items) {
          const hit = !k || (it.dataset.k || '').includes(k);
          it.style.display = hit ? '' : 'none';
          if (hit) { shown++; local++; }
        }
        s.style.display = local > 0 ? '' : 'none';
        const em = s.querySelector('.tool-group-title em');
        if (em) em.textContent = k ? String(local) : (em.getAttribute('data-n') || '');
      }
      if (countEl) countEl.textContent = k ? `${shown} 条匹配` : `${total} 条`;
      if (emptyEl) emptyEl.hidden = shown !== 0;
    };

    const boot = async () => {
      const src = body?.dataset.src;
      if (!src) return;
      try {
        const res = await fetch(src, { cache: 'force-cache' });
        const data = (await res.json()) as Group[];
        index = new Map(data.map((g) => [plain(g.group), g.items]));
      } catch (e) {
        console.error('toolbox data load failed', e);
        return;
      }
      // 数据到齐后再开始监听，避免"先渲染空组、后永不补"
      for (const s of shells) {
        const r = s.getBoundingClientRect();
        if (r.top < window.innerHeight + 600) renderGroup(s);
        else io.observe(s);
      }
    };
    boot();

    let timer: number | undefined;
    q?.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => apply(q.value), 80);
    });

    q?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        q.value = '';
        apply('');
      }
    });

    document.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement | null;
      const typing = t && /^(INPUT|TEXTAREA)$/.test(t.tagName);
      if (e.key === '/' && !typing) {
        e.preventDefault();
        q?.focus();
      }
    });

    // 侧栏滚动高亮
    const links = Array.from(document.querySelectorAll('.tool-side-link[data-target]')) as HTMLElement[];
    const map = new Map(links.map((l) => [l.dataset.target!, l]));
    const ioSide = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (!en.isIntersecting) continue;
          const link = map.get((en.target as HTMLElement).id);
          if (!link) continue;
          for (const l of links) l.classList.remove('active');
          link.classList.add('active');
        }
      },
      { rootMargin: '-96px 0px -70% 0px', threshold: 0 }
    );
    for (const s of shells) ioSide.observe(s);
  </script>
</BaseLayout>
