---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { u } from '../../lib/url';
import { TOPICS } from '../../lib/site';
import { allPosts, postTopicId, postHref, fmtDate } from '../../lib/posts';

const posts = await allPosts();
const groups = TOPICS.map((t) => ({
  ...t,
  posts: posts.filter((p) => postTopicId(p) === t.id),
}));
---
<BaseLayout title="知识库专题" description="野生思考的十个技术知识库专题，覆盖 Linux、网络、安全、云原生、数据库、全栈、面试、实验、工具箱与项目。" active="topics">
  <div class="container">
    <div class="page-head">
      <div class="kicker">INDEX / 10 TOPICS</div>
      <h1>知识库专题</h1>
      <p>
        按方向切分，而不是按时间堆叠。每个专题内部自成体系：先概念，再动手，最后是排错与追问。
      </p>
    </div>

    {
      groups.map((t) => (
        <div class="year-group">
          <div class="year-head">
            <b style={`color:${t.accent}`}>{t.index}</b>
            <a href={u(`/topics/${t.id}`)} style="font-weight:700;letter-spacing:-.01em">
              {t.name}
            </a>
            <span class="line" />
            <span>{t.posts.length} 篇</span>
          </div>
          <div style="display:grid;gap:2px">
            {t.posts.length === 0 && (
              <div class="empty" style="padding:24px 0;text-align:left">// 该专题正在整理中</div>
            )}
            {t.posts.map((p) => (
              <a class="post-row" href={u(postHref(p))}>
                <time>{fmtDate(p.data.date)}</time>
                <div class="pr-main">
                  <h3>{p.data.title}</h3>
                  <p>{p.data.description}</p>
                </div>
                <span class="pr-topic">{t.en}</span>
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</BaseLayout>
