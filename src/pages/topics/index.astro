---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { u } from '../../lib/url';
import { TOPICS, CATEGORIES } from '../../lib/site';
import { allPosts, postTopicId, postHref } from '../../lib/posts';

const posts = await allPosts();

const grouped = CATEGORIES.map((c) => {
  const list = TOPICS.filter((t) => t.category === c.id).map((t) => {
    const ps = posts.filter((p) => postTopicId(p) === t.id);
    return { ...t, count: ps.length, latest: ps.slice(0, 2) };
  });
  return { ...c, topics: list };
});
---

<BaseLayout
  title="知识地图"
  description="野生思考知识地图：从零基础到系统、网络、自动化、云原生、K8s、虚拟化、数据库、存储备份、安全、Go 与实战，全部专题按大类归位。"
  active="topics"
>
  <section class="section map-page">
    <div class="container">
      <div class="page-head">
        <div class="kicker">KNOWLEDGE MAP</div>
        <h1>一张能走完的技术地图</h1>
        <p>
          {TOPICS.length} 个专题、{CATEGORIES.length} 个大类。不按时间堆文章，按“你在哪个阶段、要解决什么问题”来分：
          先看懂机器和网络，再学会自动化和交付，最后才谈安全、性能与架构。
        </p>
      </div>

      <div class="map-legend">
        {CATEGORIES.map((c) => (
          <a class="legend-item" href={`#cat-${c.id}`}>
            <b>{c.name}</b>
            <span>{TOPICS.filter((t) => t.category === c.id).length} 专题</span>
          </a>
        ))}
      </div>

      {
        grouped.map((g, gi) => (
          <section class="map-cat" id={`cat-${g.id}`}>
            <div class="mc-head">
              <span class="mc-no">{String(gi + 1).padStart(2, '0')}</span>
              <h2>{g.name}</h2>
              <span class="mc-en">{g.en}</span>
              <span class="mc-note">{g.note}</span>
            </div>

            <div class="mc-grid">
              {g.topics.map((t) => (
                <a class="map-card" href={u(`/topics/${t.id}`)} style={`--acc:${t.accent}`}>
                  <div class="mp-top">
                    <span class="mp-icon"><Icon name={t.icon} size={17} /></span>
                    <span class="mp-no">{t.index}</span>
                  </div>
                  <h3>{t.name}</h3>
                  <div class="mp-en">{t.en}</div>
                  <p>{t.desc}</p>
                  <div class="mp-foot">
                    <span>{t.count} 篇</span>
                    {t.latest[0] && <em>{t.latest[0].data.title}</em>}
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))
      }

      <div class="map-cta">
        <div>
          <b>不知道从哪儿开始？</b>
          <p>按章节顺序走的课程在「学习中心」；按职业阶段走的在「能力路线」。</p>
        </div>
        <div class="map-cta-links">
          <a class="btn btn-primary" href={u('/learn')}>学习中心 <Icon name="arrowRight" size={15} /></a>
          <a class="btn" href={u('/roadmap')}>能力路线</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
