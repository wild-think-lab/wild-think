---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { u } from '../../lib/url';
import { TOPICS, CATEGORIES, topicById } from '../../lib/site';
import { postsByTopic, postHref, fmtDate } from '../../lib/posts';

export async function getStaticPaths() {
  return TOPICS.map((t) => ({ params: { id: t.id }, props: { topic: t } }));
}

const { topic } = Astro.props;
const topicPosts = await postsByTopic(topic.id);
const cat = CATEGORIES.find((c) => c.id === topic.category);
const siblings = TOPICS.filter((t) => t.category === topic.category && t.id !== topic.id);
const idx = TOPICS.findIndex((t) => t.id === topic.id);
const next = idx + 1 < TOPICS.length ? TOPICS[idx + 1] : undefined;
---

<BaseLayout
  title={topic.name}
  description={`${topic.name}：${topic.desc}`}
  active="topics"
>
  <section class="topic-hero" style={`--acc:${topic.accent}`}>
    <div class="container">
      <div class="breadcrumb" style="padding-top:0">
        <a href={u('/')}>首页</a><i>/</i>
        <a href={u('/topics')}>知识地图</a><i>/</i>
        <span>{topic.name}</span>
      </div>

      <div class="th-inner">
        <span class="th-icon"><Icon name={topic.icon} size={22} /></span>
        <div class="th-text">
          <div class="th-kicker">
            TOPIC {topic.index} · {topic.en}
            {cat && <span class="th-cat">{cat.name}</span>}
          </div>
          <h1>{topic.name}</h1>
          <p>{topic.desc}</p>
          <div class="th-meta">
            <span><b>{topicPosts.length}</b> 篇笔记</span>
            <span class="th-dot"></span>
            <span>{cat?.note}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container topic-wrap">
    <main>
      {
        topic.id === 'starter' && (
          <a class="callout" href={u('/learn')}>
            <div>
              <span class="cl-kicker">LEARN · 按章节推进</span>
              <h3>想“从第一章读到最后一章”？</h3>
              <p>学习中心里有 Linux、Python、网络三门课，分模块、按顺序，左边章节树，学完一章能自己验证。</p>
            </div>
            <span class="cl-go">进入学习中心 <Icon name="arrowRight" size={14} /></span>
          </a>
        )
      }
      {
        topic.id === 'tools' && (
          <a class="callout" href={u('/toolbox')}>
            <div>
              <span class="cl-kicker">TOOLBOX · 789 个站点</span>
              <h3>工具箱导航</h3>
              <p>26 个分类、789 个工具站点，支持按用途搜索，按场景直达。</p>
            </div>
            <span class="cl-go">打开工具箱 <Icon name="arrowRight" size={14} /></span>
          </a>
        )
      }

      <div class="list-head">
        <h2>本专题笔记</h2>
        <span class="mono">{topicPosts.length} NOTES</span>
      </div>

      {
        topicPosts.length === 0 ? (
          <div class="empty">// 内容正在整理，稍后更新</div>
        ) : (
          <div class="note-list">
            {topicPosts.map((p, i) => (
              <a class="note-item" href={u(postHref(p))}>
                <span class="ni-no">{String(i + 1).padStart(2, '0')}</span>
                <span class="ni-main">
                  <strong>{p.data.title}</strong>
                  <em>{p.data.description}</em>
                  <span class="ni-tags">
                    {p.data.tags.slice(0, 3).map((t) => (
                      <span>#{t}</span>
                    ))}
                  </span>
                </span>
                <time>{fmtDate(p.data.date)}</time>
                <Icon name="arrowRight" size={14} />
              </a>
            ))}
          </div>
        )
      }
    </main>

    <aside class="topic-aside">
      {
        next ? (
          <a class="side-next" href={u(`/topics/${next.id}`)} style={`--acc:${next.accent}`}>
            <span class="sn-kicker">下一个专题</span>
            <strong>{next.name}</strong>
            <em>{next.en}</em>
          </a>
        ) : (
          <a class="side-next" href={u('/topics')}>
            <span class="sn-kicker">已到地图末尾</span>
            <strong>回到知识地图</strong>
            <em>KNOWLEDGE MAP</em>
          </a>
        )
      }

      {siblings.length > 0 && (
        <div class="side-block">
          <div class="sb-title">同一分类</div>
          {siblings.map((o) => (
            <a class="sb-link" href={u(`/topics/${o.id}`)}>
              <span style={`color:${o.accent}`}>
                <Icon name={o.icon} size={14} />
              </span>
              {o.name}
            </a>
          ))}
        </div>
      )}

      <div class="side-block">
        <div class="sb-title">分类</div>
        {CATEGORIES.map((c) => (
          <a class="sb-link" href={u('/topics')}>
            <span class="mono">{TOPICS.filter((t) => t.category === c.id).length}</span>
            {c.name}
          </a>
        ))}
      </div>
    </aside>
  </div>
</BaseLayout>
