---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { u } from '../../lib/url';

export async function getStaticPaths() {
  const sheets = await getCollection('sheets');
  return sheets.map((s) => ({ params: { slug: s.id.replace(/\.md$/, '') }, props: { sheet: s } }));
}

const { sheet } = Astro.props;
const { Content, headings } = await render(sheet);

const all = (await getCollection('sheets')).sort((a, b) => (a.data.order ?? 100) - (b.data.order ?? 100));
const idx = all.findIndex((s) => s.id === sheet.id);
const prev = idx > 0 ? all[idx - 1] : undefined;
const next = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : undefined;

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<BaseLayout
  title={`${sheet.data.title} · 速查表`}
  description={sheet.data.summary}
  active="sheets"
>
  <div class="reading-bar" id="reading-bar"></div>

  <div class="container">
    <div class="breadcrumb" style="padding-top:26px">
      <a href={u('/')}>首页</a><i>/</i>
      <a href={u('/cheatsheets')}>速查表</a><i>/</i>
      <span>{sheet.data.title}</span>
    </div>

    <div class="sheet-wrap">
      <article class="sheet-doc">
        <header class="article-head">
          <div class="kicker">{sheet.data.group} · CHEATSHEET</div>
          <h1>{sheet.data.title}</h1>
          {sheet.data.summary && <p class="article-lead">{sheet.data.summary}</p>}
          {
            sheet.data.tags.length > 0 && (
              <div class="article-tags" style="margin-top:16px">
                {sheet.data.tags.map((t) => <span class="chip-static">#{t}</span>)}
              </div>
            )
          }
        </header>

        <div class="prose sheet-prose">
          <Content />
        </div>

        <footer class="article-foot">
          <div class="prevnext">
            {prev ? (
              <a class="pn" href={u(`/cheatsheets/${prev.id}`)}>
                <small>← 上一张</small>
                <span>{prev.data.title}</span>
              </a>
            ) : (
              <div />
            )}
            {next ? (
              <a class="pn next" href={u(`/cheatsheets/${next.id}`)}>
                <small>下一张 →</small>
                <span>{next.data.title}</span>
              </a>
            ) : (
              <div />
            )}
          </div>
        </footer>
      </article>

      {
        toc.length > 2 && (
          <aside class="toc" id="toc">
            <div class="toc-title">On this page</div>
            <ul>
              {toc.map((h) => (
                <li class={h.depth === 3 ? 'depth-3' : 'depth-2'}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </div>

  <script>
    const bar = document.getElementById('reading-bar');
    const update = () => {
      const h = document.documentElement;
      const total = h.scrollHeight - h.clientHeight;
      if (bar) bar.style.width = Math.min(100, Math.max(0, total > 0 ? (h.scrollTop / total) * 100 : 0)) + '%';
    };
    document.addEventListener('scroll', update, { passive: true });
    update();

    const links = Array.from(document.querySelectorAll('#toc a')) as HTMLAnchorElement[];
    const targets = links
      .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter(Boolean) as HTMLElement[];
    if (targets.length) {
      const io = new IntersectionObserver(
        (es) => {
          es.forEach((e) => {
            if (!e.isIntersecting) return;
            links.forEach((a) =>
              a.classList.toggle('active', decodeURIComponent(a.hash.slice(1)) === e.target.id)
            );
          });
        },
        { rootMargin: '-90px 0px -70% 0px', threshold: 0 }
      );
      targets.forEach((t) => io.observe(t));
    }
  </script>
</BaseLayout>
